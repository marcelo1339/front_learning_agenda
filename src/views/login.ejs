<%- include("./includes/head")%>
<%- include("./includes/nav")%>
    <div class="container">
        <div class="row">
            <div class="col-lg-2"></div>
            
            <div class="col-lg-8 my-3">
                <h1 class="text-center">Entrada</h1>
                <p class="text-center lead">Faça login ou crie sua conta abaixo</p>
            </div>

            <%- include("./includes/messages")%>
            
            <div class="row">
                <div class="col-lg">
                    <h4>Cadastrar</h4>
                    <p>Cadastre-se caso não possua uma conta.</p>
                    <form action="/login/register" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="email">Endereço de email</label>
                            <input type="email" name="email" id="email" class="form-control" aria-describedby="emailHelp" placeholder="Insira seu email">
                            <small id="emailHelp" class="form-text text-muted fs-7">Não compartilharemos seu email com ninguém.</small>
                        </div>
                        <div class="form-group mt-2">
                            <label for="senha">Senha</label>
                            <input type="password" class="form-control" id="senha" name="senha" placeholder="Insira sua senha">
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Criar Conta</button>
                    </form>
                </div>
                
                
                <div class="col-lg">
                    <h4>Entrar</h4>
                    <p>Entre se já possuir uma conta cadastrada.</p>
                    <form action="/login/login" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="email">Endereço de email</label>
                            <input type="email" name="email" id="email" class="form-control" aria-describedby="emailHelp" placeholder="Insira seu email">
                            <small id="emailHelp" class="form-text text-muted fs-7 invisible">Não compartilharemos seu email com ninguém.</small>
                        </div>

                        <div class="form-group mt-2">
                            <label for="senha">Senha</label>
                            <input type="password" class="form-control" id="senha" placeholder="Insira sua senha">
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Entrar</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-2"></div>
        </div>
    </div>
<%- include("./includes/footer")%>
