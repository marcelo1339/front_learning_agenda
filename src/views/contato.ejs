<%- include("./includes/head")%>
<%- include("./includes/nav")%>
    <div class="container">
        <div class="row">
            <div class="col-lg-2"></div>
            
            <div class="col-lg-8 my-3">
                <h1 class="text-center">Contato</h1>
                <p class="text-center lead">Crie ou edite seu contato abaixo.</p>

                <%- include("./includes/messages") %>

                <form action="/contato/register" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    
                    <div class="form-group">
                        <label for="nome">Nome</label>
                        <input type="text" name="nome" class="form-control" aria-describedby="Nome" placeholder="Insira seu nome">
                    </div>

                    <div class="form-group">
                        <label for="sobrenome">Sobrenome</label>
                        <input type="text" name="sobrenome" class="form-control" aria-describedby="Sobrenome" placeholder="Insira seu sobrenome">
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" name="email" class="form-control" aria-describedby="Email" placeholder="Insira seu email">
                    </div>

                    <div class="form-group">
                        <label for="telefone">Telefone</label>
                        <input type="tel" name="telefone" class="form-control" aria-describedby="Telefone" placeholder="Insira seu telefone">
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Entrar</button>
                </form>

            </div>

            <div class="col-lg-2"></div>
        </div>
    </div>
<%- include("./includes/footer")%>
