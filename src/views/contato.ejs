<%- include("./includes/head")%>
<%- include("./includes/nav")%>
    <div class="container">
        <div class="row">
            <div class="col-lg-2"></div>
            
            <div class="col-lg-8 my-3">
                <h1 class="text-center">Contato</h1>
                <p class="text-center lead">Crie ou edite seu contato abaixo.</p>

                <%- include("./includes/messages") %>
                
                <% if(contato._id) { %>
                    <form action="/contato/edit/<%= contato._id %>" method="post">
                <% } else { %>            
                    <form action="/contato/register" method="post">
                <% } %>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <label for="nome">Nome</label>
                        <input type="text" name="nome" class="form-control" aria-describedby="Nome" placeholder="Insira seu nome" value="<%= contato.nome %>">
                    </div>

                    <div class="form-group">
                        <label for="sobrenome">Sobrenome</label>
                        <input type="text" name="sobrenome" class="form-control" aria-describedby="Sobrenome" placeholder="Insira seu sobrenome" value="<%= contato.sobrenome %>">
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" name="email" class="form-control" aria-describedby="Email" placeholder="Insira seu email" value="<%= contato.email %>">
                    </div>

                    <div class="form-group">
                        <label for="telefone">Telefone</label>
                        <input type="tel" name="telefone" class="form-control" aria-describedby="Telefone" placeholder="Insira seu telefone" value="<%= contato.telefone %>">
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Entrar</button>
                </form>

            </div>

            <div class="col-lg-2"></div>
        </div>
    </div>
<%- include("./includes/footer")%>
